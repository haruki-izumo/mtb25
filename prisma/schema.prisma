generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  INTERVIEWER
}

enum OverrideType {
  BLOCK
  OPEN
}

enum ProcessStatus {
  OFFER
  FIRST_STEP
  NEXT_ROUND
  NEXT_STEP
  ASSESSMENT
  DONE
  RESCHEDULE
  SKIPPED
  FAILED
  CANCELED
  NOT_HANDLED
  NOT_RESCHEDULED
}

enum RoundType {
  HR_RECRUITER
  TECH
  ASSESSMENT
  SYSTEM_DESIGN
  BEHAVIORAL
  FINAL
  OTHER
}

enum RoundOutcome {
  PENDING
  PASSED
  FAILED
  RESCHEDULED
  CANCELED
  NO_SHOW
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

enum ApiKeyMode {
  FREE
  PRO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  avatarColor  String   @default("#2563eb")
  timezone     String   @default("America/New_York")
  createdAt    DateTime @default(now())

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  assignedProfiles     Profile[] @relation("ProfileAssignments")
  interviewingProfiles Profile[] @relation("ProfileInterviewer")
  ownedProcesses       InterviewProcess[] @relation("ProcessOwner")
  bookedRounds         Round[]            @relation("RoundBookedBy")
  ownedApplications    Application[]      @relation("ApplicationOwner")

  availabilityRules     UserAvailabilityRule[]
  availabilityOverrides UserAvailabilityOverride[]

  managedProjects       Project[]             @relation("ProjectManager")
  projectMemberships    Project[]             @relation("ProjectTeam")
  createdProjects       Project[]             @relation("ProjectCreatedBy")
  updatedProjects       Project[]             @relation("ProjectUpdatedBy")
  projectStatusChanges  ProjectStatusHistory[]
  projectActivities     ProjectActivity[]
  projectAttachments    ProjectAttachment[]
}

model Team {
  id      String @id @default(cuid())
  name    String
  members User[]
}

model Profile {
  id            String   @id @default(cuid())
  code          String   @unique
  displayName   String
  fullName      String
  email         String
  phone         String?
  location      String?
  zipCode       String?
  country       String
  timezone      String
  linkedinUrl   String?
  githubUrl     String?
  resumeFileUrl String?
  starred       Boolean  @default(false)
  createdAt     DateTime @default(now())

  /** Extension / resume-generation fields */
  firstName          String?
  lastName           String?
  education          Json     @default("[]")
  certifications     Json     @default("[]")
  bulletMin          Int      @default(10)
  bulletMax          Int      @default(12)
  resumeTemplateId   String   @default("style2")
  autoFillPrefs      Json     @default("{}")
  promptId           String?
  autoFillPromptId   String?

  /** One designated interviewer for this profile */
  interviewerId String?
  interviewer   User?    @relation("ProfileInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  assignedMembers User[] @relation("ProfileAssignments")

  experiences            Experience[]
  availabilityRules      AvailabilityRule[]
  availabilityOverrides  AvailabilityOverride[]
  processes              InterviewProcess[]
  applications           Application[]
  apiKeys                ProfileApiKey[]

  @@index([interviewerId])
}

model ProfileApiKey {
  id        String    @id @default(cuid())
  profileId String
  mode      ApiKeyMode
  /** Gemini / provider API key (server-only; never list raw to clients) */
  key       String
  label     String?
  createdAt DateTime  @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, mode])
}

model Experience {
  id        String    @id @default(cuid())
  profileId String
  company   String
  role      String
  location  String?
  startDate DateTime
  endDate   DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AvailabilityRule {
  id          String @id @default(cuid())
  profileId   String
  weekday     Int
  startMinute Int
  endMinute   Int

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AvailabilityOverride {
  id          String       @id @default(cuid())
  profileId   String
  date        DateTime     @db.Date
  startMinute Int?
  endMinute   Int?
  type        OverrideType

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, date])
}

/** Personal availability for INTERVIEWER users */
model UserAvailabilityRule {
  id          String @id @default(cuid())
  userId      String
  weekday     Int
  startMinute Int
  endMinute   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAvailabilityOverride {
  id          String       @id @default(cuid())
  userId      String
  date        DateTime     @db.Date
  startMinute Int?
  endMinute   Int?
  type        OverrideType

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model InterviewProcess {
  id             String        @id @default(cuid())
  profileId      String
  companyName    String
  jobTitle       String
  jobUrl         String?
  jobDescription String?
  resumeFileUrl  String?
  ownerMemberId  String
  status         ProcessStatus
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  owner   User    @relation("ProcessOwner", fields: [ownerMemberId], references: [id])
  rounds  Round[]

  @@index([profileId])
  @@index([ownerMemberId])
  @@index([status])
}

model Round {
  id                     String       @id @default(cuid())
  processId              String
  roundNumber            Int
  type                   RoundType
  startAt                DateTime
  endAt                  DateTime
  /** Our assigned interviewer (profile interviewer display name) */
  interviewerName        String
  /** Interviewer at the client / hiring company */
  clientInterviewerName  String       @default("")
  clientInterviewerAbout String?
  meetingLink            String?
  bookedById             String
  outcome                RoundOutcome @default(PENDING)
  rating                 Int?
  feedback               String?
  createdAt              DateTime     @default(now())

  process  InterviewProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  bookedBy User             @relation("RoundBookedBy", fields: [bookedById], references: [id])

  @@index([processId])
  @@index([startAt, endAt])
  @@index([bookedById])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Application {
  id             String            @id @default(cuid())
  profileId      String
  ownerId        String?
  company        String
  jobTitle       String
  url            String?
  status         ApplicationStatus @default(APPLIED)
  appliedAt      DateTime?
  applied        Boolean           @default(true)
  submitted      Boolean           @default(false)
  mode           String?
  resumeTemplate String?
  keyPreview     String?
  resultInfo     Json?
  resumePdfUrl   String?
  coverPdfUrl    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  owner   User?   @relation("ApplicationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([ownerId])
  @@index([createdAt])
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectActivityType {
  STATUS_CHANGE
  FIELD_EDIT
  COMMENT
  FILE_UPLOAD
  CREATED
}

model Client {
  id            String   @id @default(cuid())
  name          String
  country       String
  contactPerson String?
  email         String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]

  @@index([name])
  @@index([country])
}

model ProjectType {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  projects Project[]
}

model ProjectStatusDef {
  id        String  @id @default(cuid())
  key       String  @unique
  name      String
  color     String
  sortOrder Int
  isFinal   Boolean @default(false)

  projectsAsStatus Project[] @relation("ProjectCurrentStatus")
  transitionsFrom  ProjectStatusTransition[] @relation("TransitionFrom")
  transitionsTo    ProjectStatusTransition[] @relation("TransitionTo")
  historyFrom      ProjectStatusHistory[] @relation("HistoryFrom")
  historyTo        ProjectStatusHistory[] @relation("HistoryTo")
}

model ProjectStatusTransition {
  id           String @id @default(cuid())
  fromStatusId String
  toStatusId   String

  fromStatus ProjectStatusDef @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   ProjectStatusDef @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
}

model Project {
  id              String          @id @default(cuid())
  projectCode     String          @unique
  projectName     String
  clientId        String
  country         String
  city            String?
  industry        String?
  projectTypeId   String?
  description     String
  scopeOfWork     String?
  budget          Decimal         @db.Decimal(14, 2)
  currency        String          @default("USD")
  contractValue   Decimal?        @db.Decimal(14, 2)
  paymentTerms    String?
  dateSecured     DateTime        @db.Date
  startDate       DateTime?       @db.Date
  expectedEndDate DateTime?       @db.Date
  actualEndDate   DateTime?       @db.Date
  projectManagerId String
  priority        ProjectPriority @default(MEDIUM)
  statusId        String
  progressPercent Int             @default(0)
  tags            String[]        @default([])
  notes           String?
  archivedAt      DateTime?
  createdById     String
  updatedById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client         Client           @relation(fields: [clientId], references: [id])
  projectType    ProjectType?     @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  status         ProjectStatusDef @relation("ProjectCurrentStatus", fields: [statusId], references: [id])
  projectManager User             @relation("ProjectManager", fields: [projectManagerId], references: [id])
  teamMembers    User[]           @relation("ProjectTeam")
  createdBy      User             @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?            @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  statusHistory  ProjectStatusHistory[]
  activities     ProjectActivity[]
  attachments    ProjectAttachment[]

  @@index([statusId])
  @@index([projectManagerId])
  @@index([clientId])
  @@index([dateSecured])
  @@index([archivedAt])
  @@index([updatedAt])
}

model ProjectStatusHistory {
  id           String   @id @default(cuid())
  projectId    String
  fromStatusId String?
  toStatusId   String
  changedById  String
  changedAt    DateTime @default(now())
  comment      String?

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus ProjectStatusDef? @relation("HistoryFrom", fields: [fromStatusId], references: [id], onDelete: SetNull)
  toStatus   ProjectStatusDef  @relation("HistoryTo", fields: [toStatusId], references: [id])
  changedBy  User              @relation(fields: [changedById], references: [id])

  @@index([projectId, changedAt])
}

model ProjectActivity {
  id        String              @id @default(cuid())
  projectId String
  userId    String
  type      ProjectActivityType
  message   String
  meta      Json?
  createdAt DateTime            @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
}

model ProjectAttachment {
  id           String   @id @default(cuid())
  projectId    String
  fileName     String
  url          String
  uploadedById String
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
}

model ProjectCodeCounter {
  year  Int @id
  lastN Int @default(0)
}
