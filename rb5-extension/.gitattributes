# Normalize line endings: store everything as LF in the repo, regardless
# of the contributor's OS. Stops the "LF will be replaced by CRLF" churn
# on Windows checkouts.
* text=auto eol=lf

# Treat these as binary (never touch line endings).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.7z binary
*.zip binary
